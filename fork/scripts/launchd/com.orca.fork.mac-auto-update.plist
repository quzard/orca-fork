<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.orca.fork.mac-auto-update</string>
  <key>ProgramArguments</key>
  <array>
    <string>__BIN__/mac-auto-update.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>ORCA_REPO</key>
    <string>__REPO__</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:__HOME__/.orbstack/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Projects/orca-verify/mac-auto-update.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Projects/orca-verify/mac-auto-update.err.log</string>
  <key>Nice</key>
  <integer>5</integer>
</dict>
</plist>
